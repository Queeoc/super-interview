# 应用配置
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# DashScope / LLM 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
RAG_TOP_K=3
RAG_MODEL=qwen-max

# 文档切分配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# PostgreSQL 配置
POSTGRES_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=biz_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_ECHO=false

# Redis 配置
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=biz_agent

# 限流配置
# 是否启用 Redis Lua 滑动窗口限流；启用后会保护 /api/interview、/api/resume、/api/knowledge、/api/providers
RATE_LIMIT_ENABLED=true
# 限流窗口大小，单位秒
RATE_LIMIT_WINDOW_SECONDS=60
# 读接口限流阈值：GLOBAL / IP / USER
RATE_LIMIT_READ_GLOBAL_LIMIT=1200
RATE_LIMIT_READ_IP_LIMIT=240
RATE_LIMIT_READ_USER_LIMIT=120
# 写接口限流阈值：GLOBAL / IP / USER
RATE_LIMIT_WRITE_GLOBAL_LIMIT=600
RATE_LIMIT_WRITE_IP_LIMIT=120
RATE_LIMIT_WRITE_USER_LIMIT=60

# Redis Stream 异步任务配置
# 是否启用异步任务；启用后面试报告会优先走异步生成
STREAM_TASK_ENABLED=true
# 主任务流名称
STREAM_TASK_STREAM_NAME=async_tasks
# 死信队列名称，超过最大重试次数的任务会进入这里
STREAM_TASK_DEAD_LETTER_STREAM_NAME=async_tasks_dead_letter
# 任务状态缓存 key 前缀
STREAM_TASK_STATUS_KEY_PREFIX=async_task:status
# Consumer Group 名称
STREAM_TASK_CONSUMER_GROUP=biz-agent
# Consumer 名称前缀，系统启动后会自动拼接随机后缀
STREAM_TASK_CONSUMER_NAME_PREFIX=worker
# 单次最多拉取多少条消息
STREAM_TASK_READ_COUNT=10
# 阻塞读取等待时间，单位毫秒
STREAM_TASK_BLOCK_MS=1000
# 多久未 ACK 的消息会被重新认领，单位毫秒
STREAM_TASK_CLAIM_IDLE_MS=60000
# 单个任务最大重试次数
STREAM_TASK_MAX_RETRIES=3
# Stream 最大长度，超过后按 Redis 策略裁剪旧消息
STREAM_TASK_MAXLEN=5000
# 后台消费轮询间隔，单位秒
STREAM_TASK_WORKER_POLL_INTERVAL_SECONDS=1
# 当异步任务不可用时，是否允许回退为同步执行，保证主流程不被卡死
STREAM_TASK_SYNCHRONOUS_FALLBACK_ENABLED=true

# Storage 配置
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=uploads
STORAGE_TEMP_DIR=uploads/tmp
